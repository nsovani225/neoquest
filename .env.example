# Optional overrides. Dev defaults live in .env.development, so leave this unset locally.
# In production set all of these on the host:
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
EXPO_PUBLIC_API_URL=
# Server only. Required in production (openssl rand -hex 32); generated per run in development.
SESSION_SECRET=
